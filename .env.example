# Copy these values into your hosting provider's environment settings.
# Do not commit real secrets to source control.
BUNKSAFE_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
BUNKSAFE_ADMIN_EMAIL=admin@example.com
BUNKSAFE_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-characters
BUNKSAFE_HTTPS=1
BUNKSAFE_ENV=production
# Optional: absolute path to a persistent SQLite database file.
# BUNKSAFE_DB_PATH=/persistent/path/bunksafe.db
