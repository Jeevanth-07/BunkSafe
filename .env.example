# Local development (SQLite)
BUNKSAFE_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
BUNKSAFE_ENV=development
BUNKSAFE_HTTPS=0
# For Vercel production, set these in Vercel Project Settings > Environment Variables.
# BUNKSAFE_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# BUNKSAFE_SECRET_KEY=generate-a-random-secret-at-least-32-characters
# BUNKSAFE_ENV=production
# BUNKSAFE_HTTPS=1
# BUNKSAFE_ADMIN_EMAIL=your-admin-email@example.com
# BUNKSAFE_ADMIN_PASSWORD=use-a-unique-strong-password
